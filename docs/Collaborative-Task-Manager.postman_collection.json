{
  "info": {
    "name": "Collaborative Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": "paste-jwt-here"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Signup (User only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Taylor User\",\"email\":\"newuser@example.com\",\"password\":\"DemoPass123!\"}"
        },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"manager@example.com\",\"password\":\"Demo1234!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Create task (Manager)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Review assessment\",\"description\":\"Validate the MVP flow\",\"status\":\"To Do\",\"priority\":\"High\"}"
        },
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "Task activity (replace taskId)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/tasks/taskId/activity"
      }
    }
  ]
}