# Copy to backend/.env and fill in your own values
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/collaborative_task_manager
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# MySQL settings for the provided SQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=collaborative_task_manager
DB_USER=root
DB_PASSWORD=
